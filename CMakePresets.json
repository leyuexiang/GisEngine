{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "原生 Debug",
      "description": "使用默认本机编译器构建 GisEngine 原生基线",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/native-debug-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GISENGINE_BUILD_SAMPLES": "ON",
        "GISENGINE_BUILD_TOOLS": "ON",
        "GISENGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "native-release",
      "displayName": "原生 Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GISENGINE_BUILD_SAMPLES": "ON",
        "GISENGINE_BUILD_TOOLS": "ON",
        "GISENGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "native-sanitize",
      "displayName": "原生 Sanitizer Debug",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/out/build/native-sanitize-mingw",
      "description": "使用 AddressSanitizer 和 UndefinedBehaviorSanitizer 检查内存与未定义行为",
      "cacheVariables": {
        "GISENGINE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "vs-ninja-debug",
      "displayName": "Visual Studio 2026 Debug",
      "description": "在 VS 2026 x64 开发者环境中使用 Ninja 和 MSVC 构建",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/vs-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "GISENGINE_BUILD_SAMPLES": "ON",
        "GISENGINE_BUILD_TOOLS": "ON",
        "GISENGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs-ninja-sanitize",
      "displayName": "Visual Studio 2026 AddressSanitizer",
      "inherits": "vs-ninja-debug",
      "binaryDir": "${sourceDir}/out/build/vs-ninja-sanitize",
      "description": "在 VS 2026 x64 开发者环境中启用 AddressSanitizer",
      "cacheVariables": {
        "GISENGINE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "web-debug",
      "displayName": "WebAssembly Debug",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/out/build/web-debug",
      "description": "由 Emscripten 工具链文件覆盖编译器后复用同一目标边界",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize"
    },
    {
      "name": "vs-ninja-debug",
      "configurePreset": "vs-ninja-debug"
    },
    {
      "name": "vs-ninja-sanitize",
      "configurePreset": "vs-ninja-sanitize"
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs-ninja-debug",
      "configurePreset": "vs-ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs-ninja-sanitize",
      "configurePreset": "vs-ninja-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
